# OS
.DS_Store
Thumbs.db

# Secrets / local env (never push)
.env
.env.*
!.env.example

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian: keep vault settings, not this machine's open-file layout
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# The app's own dependencies/build output are covered by
# react-app/.gitignore — these are just a safety net in case something
# gets installed/built at the vault root by accident
node_modules/
dist/
dist-ssr/
*.local
